      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        -240,
        64
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $json;\n// ISO timestamps contain colons, which collide with our ':' delimited callback_data.\n// Strip them out here; parsed back on the callback side by re-inserting them positionally.\nlet version = '';\nif (j.recordVersion) {\n  const d = new Date(j.recordVersion);\n  if (!isNaN(d.getTime())) {\n    version = d.toISOString().replace(/[:]/g, '');\n  }\n}\nconst base = `appr:${j.leadId}:${j.field}:${j.newValue}:${version}`;\nconst label = j.field === 'status' ? `${j.oldValue} \\u2192 ${j.newValue}` : `\\u20b9${Number(j.oldValue).toLocaleString('en-IN')} \\u2192 \\u20b9${Number(j.newValue).toLocaleString('en-IN')}`;\nreturn [{ json: {\n  chatId: j.chatId,\n  businessName: j.businessName,\n  fieldLabel: j.field === 'status' ? 'Status change' : 'Deal value change',\n  changeLabel: label,\n  callbackApprove: `${base}:A`,\n  callbackReject: `${base}:R`\n} }];"
      },
      "id": "aaa17c5c-2a79-44bb-9efb-a168cdad7827",
      "name": "Build Approval Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -16,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{$json.chatId}}",
        "text": "=Confirm this change?\n\n<b>{{$json.businessName}}</b>\n{{$json.fieldLabel}}: {{$json.changeLabel}}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "✅ Approve",
                    "additionalFields": {
                      "callback_data": "={{$json.callbackApprove}}"
                    }
                  },
                  {
                    "text": "❌ Reject",
                    "additionalFields": {
                      "callback_data": "={{$json.callbackReject}}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "e12a82ed-9e29-400b-8dbe-2ee0170bfb58",
      "name": "Send Approval Request",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        208,
        0
      ],
      "webhookId": "542fb3c3-be35-4d79-8e08-905de4dea7da",
      "credentials": {
        "telegramApi": {
          "id": "ANhhemYmmRjIkSZo",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const j = $json;\nconst parts = (j.callbackData || '').split(':');\n// Re-insert the colons that were stripped out before the timestamp went into callback_data,\n// so this is a valid ISO timestamp again for comparisons and the SQL parameter.\nconst version = (parts[4] || '').replace(/T(\\d{2})(\\d{2})(\\d{2})/, 'T$1:$2:$3');\nreturn [{ json: {\n  leadId: Number(parts[1]), field: parts[2], newValue: parts[3], version, decision: parts[5],\n  chatId: j.chatId, callbackQueryId: j.callbackQueryId, messageId: j.messageId\n} }];"
      },
      "id": "5be33660-4c72-43d8-bc1f-c293f4662395",
      "name": "Parse Approval Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -16,
        192
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, business_name, status, deal_value, updated_at FROM leads WHERE id = $1",
        "options": {
          "queryReplacement": "={{ [$json.leadId] }}"
        }
      },
      "id": "78cbb543-2b30-4dbe-952d-ad21bb2317f6",
      "name": "Reread Current Record",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        208,
        192
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "o9wS8silxqFIed1B",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const p = $('Parse Approval Callback').first().json;\nconst cur = $json;\nconst notFound = !cur.id;\nconst curVersion = cur.updated_at ? new Date(cur.updated_at).toISOString() : '';\nconst stale = notFound || curVersion !== p.version;\nreturn [{ json: { ...p, currentBusinessName: cur.business_name, notFound, stale } }];"
      },
      "id": "86cc6fb7-d155-4f79-b5e6-1108ea81e327",
      "name": "Check Staleness",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        192
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{$json.stale}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "701bcfe6-d1a4-4f53-b9a9-e7961ac924dd",
      "name": "Is Stale",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        656,
        192
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $json;\nconst text = j.notFound\n  ? `\\u26a0\\ufe0f This lead no longer exists (it may have been deleted). No update made.`\n  : `\\u26a0\\ufe0f This record changed since the request was made. Please re-run the command to review the current value.`;\nreturn [{ json: { chatId: j.chatId, callbackQueryId: j.callbackQueryId, messageId: j.messageId, text } }];"
      },
      "id": "95cf5cf3-dbff-4423-8771-ea29464299fc",
      "name": "Build Stale Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        96
      ]
    },
    {
