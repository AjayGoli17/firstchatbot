            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{$json.decision}}",
              "rightValue": "A",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "id": "7647b4ea-dbf6-402c-94dd-f7db841add4d"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b21c2b79-0d4b-4b0e-9e23-aba04d36d2a9",
      "name": "Is Approved",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "const original = $('Check Staleness').item.json;\nconst j = $json;\nreturn [{\n  json: {\n    chatId: original.chatId,\n    callbackQueryId: original.callbackQueryId,\n    messageId: original.messageId,\n    text: `❌ Change rejected for <b>${original.currentBusinessName}</b>. No update made.`\n  }\n}];"
      },
      "id": "e6461dfb-b896-45cf-b09a-9c678b86469b",
      "name": "Build Reject Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1328,
        384
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE leads SET\n  status = CASE WHEN $2 = 'status' THEN $3 ELSE status END,\n  deal_value = CASE WHEN $2 = 'deal_value' THEN $3::text::numeric ELSE deal_value END,\n  won_at = CASE WHEN $2 = 'status' AND $3 = 'WON' THEN now() ELSE won_at END\nWHERE id = $1\nRETURNING *",
        "options": {
          "queryReplacement": "={{ [$json.leadId, $json.field, $json.newValue] }}"
        }
      },
      "id": "e46d07a7-f867-42d7-82bb-a0003b0ddc21",
