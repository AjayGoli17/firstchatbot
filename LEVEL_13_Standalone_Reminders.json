    {
      "id": "extract13",
      "name": "Extract Reminder Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const trigItem = $input.first().json;\nconst cmd = trigItem.command || \"CREATE_REMINDER\";\nconst params = trigItem.parameters || {};\nconst userId = String(trigItem.userId || trigItem.chatId || \"\");\nconst chatId = trigItem.chatId;\n\nfunction parseNaturalDateTime(text) {\n  if (!text) return null;\n  const str = String(text).toLowerCase().trim();\n  const now = new Date();\n  \n  if (str.startsWith(\"in \") && (str.includes(\"minute\") || str.includes(\"min\"))) {\n    const match = str.match(/in\\s+(\\d+)\\s*min/);\n    if (match) return new Date(now.getTime() + parseInt(match[1], 10) * 60000).toISOString();\n  }\n  if (str.startsWith(\"in \") && (str.includes(\"hour\") || str.includes(\"hr\"))) {\n    const match = str.match(/in\\s+(\\d+)\\s*h/);\n    if (match) return new Date(now.getTime() + parseInt(match[1], 10) * 3600000).toISOString();\n  }\n  if (str.startsWith(\"in \") && str.includes(\"day\")) {\n    const match = str.match(/in\\s+(\\d+)\\s*day/);\n    if (match) return new Date(now.getTime() + parseInt(match[1], 10) * 86400000).toISOString();\n  }\n  \n  if (str.includes(\"tomorrow\")) {\n    const target = new Date(now.getTime() + 86400000);\n    const timeMatch = str.match(/(\\d{1,2})(?::(\\d{2}))?\\s*(am|pm)?/);\n    if (timeMatch) {\n      let hours = parseInt(timeMatch[1], 10);\n      const minutes = timeMatch[2] ? parseInt(timeMatch[2], 10) : 0;\n      const ampm = timeMatch[3];\n      if (ampm === \"pm\" && hours < 12) hours += 12;\n      if (ampm === \"am\" && hours === 12) hours = 0;\n      target.setHours(hours, minutes, 0, 0);\n    } else {\n      target.setHours(9, 0, 0, 0);\n    }\n    return target.toISOString();\n  }\n  \n  const parsed = Date.parse(text);\n  if (!isNaN(parsed)) return new Date(parsed).toISOString();\n  return null;\n}\n\nlet content = params && (params.content || params.reminder_text || params.task || params.message);\nif (!content && trigItem.text) {\n  const match = trigItem.text.match(/^(?:remind me to|remind me|reminder to|reminder:?)\\s*(.+?)(?:\\s+(?:at|on|tomorrow|in)\\s+.*)?$/i);\n  if (match) content = match[1].trim();\n  if (!content && trigItem.text) content = trigItem.text.trim();\n}\n\nlet rawDate = params && (params.reminder_at || params.follow_up_date || params.due_at || params.due_date);\nlet reminderAt = parseNaturalDateTime(rawDate) || (rawDate ? new Date(rawDate).toISOString() : new Date(Date.now() + 24 * 3600000).toISOString());\n\nlet reminderId = null;\nif (params && (params.reminder_id || params.id)) {\n  const rawId = String(params.reminder_id || params.id).replace(/[^0-9]/g, \"\");\n  if (rawId) reminderId = parseInt(rawId, 10);\n}\n\nconst confirmed = params && (params.confirmed === true || String(params.confirmed).toLowerCase() === \"true\");\n\nreturn [{\n  json: {\n    command: cmd,\n    chatId,\n    userId,\n    content,\n    reminderAt,\n    reminderId,\n    confirmed,\n    parameters: params,\n    text: trigItem.text\n  }\n}];"
      }
    },
