    {
      "id": "fmt_create_success",
      "name": "Format Create Success Confirmation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const trig = $(\"Extract Reminder Input\").first().json;\nconst r = $(\"Prepare GCal Payload\").first().json;\nlet dateStr = r.reminder_at;\ntry {\n  const d = new Date(r.reminder_at);\n  if (!isNaN(d.getTime())) {\n    dateStr = new Intl.DateTimeFormat(\"en-IN\", {\n      timeZone: \"Asia/Kolkata\",\n      dateStyle: \"medium\",\n      timeStyle: \"short\"\n    }).format(d);\n  }\n} catch (e) {}\n\nreturn [{\n  json: {\n    chatId: trig.chatId,\n    text: `🔔 <b>Reminder set!</b> (ID: #${r.reminderId})\\n\\n<b>What:</b> ${r.summary}\\n<b>When:</b> ${dateStr}\\n\\n📅 Added to Google Calendar.`,\n    reminderId: r.reminderId\n  }\n}];"
      }
