    {
      "id": "prep_gcal13",
      "name": "Prepare GCal Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        60
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const trig = $(\"Extract Reminder Input\").first().json;\nconst r = $input.first().json;\nif (!r || !r.id) {\n  return [{ json: { error: \"Failed to insert reminder\" } }];\n}\n\nlet startIso = r.reminder_at;\nlet endIso;\ntry {\n  const startDate = new Date(r.reminder_at);\n  if (!isNaN(startDate.getTime())) {\n    startIso = startDate.toISOString();\n    endIso = new Date(startDate.getTime() + 5 * 60 * 1000).toISOString();\n  }\n} catch (e) {\n  endIso = startIso;\n}\n\nreturn [{\n  json: {\n    reminderId: r.id,\n    content: r.content,\n    reminder_at: r.reminder_at,\n    summary: r.content,\n    description: \"Created by Nexo Telegram Bot\",\n    start: startIso,\n    end: endIso,\n    timeZone: \"Asia/Kolkata\"\n  }\n}];"
      }
    },
