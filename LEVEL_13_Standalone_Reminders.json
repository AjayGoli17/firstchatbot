      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO standalone_reminders (user_id, chat_id, content, reminder_at) VALUES ($1, $2, $3, $4) RETURNING id, content, reminder_at, status",
        "options": {
          "queryReplacement": "={{ [ $json.userId, String($json.chatId), $json.content, $json.reminderAt ] }}"
        }
