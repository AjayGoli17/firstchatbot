    {
      "id": "fmt_list13",
      "name": "Format Reminders List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const trig = $(\"Extract Reminder Input\").first().json;\nconst remList = $input.all().map(i => i.json).filter(i => i && i.id);\nif (remList.length === 0) {\n  return [{ json: { chatId: trig.chatId, text: \"🔔 You don't have any active reminders.\" } }];\n}\nconst lines = remList.map((rem, idx) => {\n  let dateStr = rem.reminder_at;\n  try {\n    const d = new Date(rem.reminder_at);\n    if (!isNaN(d.getTime())) {\n      dateStr = new Intl.DateTimeFormat(\"en-IN\", {\n        timeZone: \"Asia/Kolkata\",\n        dateStyle: \"medium\",\n        timeStyle: \"short\"\n      }).format(d);\n    }\n  } catch (e) {}\n  const calTag = rem.google_calendar_event_id ? \"\\n   📅 Google Calendar\" : \"\";\n  return `${idx + 1}. (ID: #${rem.id}) ⏰ ${dateStr}\\n   ${rem.content}${calTag}`;\n});\nconst text = `🔔 <b>YOUR REMINDERS</b>\\n\\n${lines.join(\"\\n\\n\")}`;\nreturn [{ json: { chatId: trig.chatId, text } }];"
      }
