{
  "name": "LEVEL_14_Daily_Task_Scheduler",
  "nodes": [
    {
      "id": "schedule_trigger_tasks",
      "name": "Morning Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 8,
              "triggerAtMinute": 30
            }
          ]
        }
      }
    },
    {
      "id": "get_today_pending_tasks",
      "name": "Get Today Incomplete Tasks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH claim AS (\n  UPDATE personal_daily_tasks\n  SET notified_at = now(), updated_at = now()\n  WHERE id IN (\n    SELECT id\n    FROM personal_daily_tasks\n    WHERE status = 'PENDING'\n      AND notified_at IS NULL\n      AND task_date = now()::date\n    FOR UPDATE SKIP LOCKED\n  )\n  RETURNING id, user_id, chat_id, task_date, content, priority\n)\nSELECT id, user_id, chat_id, task_date, content, priority\nFROM claim\nORDER BY user_id, CASE priority WHEN 'HIGH' THEN 1 WHEN 'MEDIUM' THEN 2 WHEN 'LOW' THEN 3 ELSE 4 END, id ASC",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "if_any_tasks",
      "name": "Any Tasks",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{$json.id}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "group_tasks_by_user",
      "name": "Group Tasks By User",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const taskRecords = $input.all().map(i => i.json).filter(i => i && i.id);\nif (taskRecords.length === 0) return [];\n\nconst groups = {};\nfor (const task of taskRecords) {\n  const key = `${task.user_id}_${task.chat_id || \"\"}`;\n  if (!groups[key]) {\n    groups[key] = {\n      userId: task.user_id,\n      chatId: task.chat_id || $env.PERSONAL_CHAT_ID,\n      taskIds: [],\n      tasks: []\n    };\n  }\n  groups[key].taskIds.push(task.id);\n  const pBadge = task.priority === \"HIGH\" ? \" [HIGH]\" : (task.priority === \"LOW\" ? \" [LOW]\" : \"\");\n  const icon = task.priority === \"HIGH\" ? \"🔴\" : \"▫️\";\n  groups[key].tasks.push(`${icon} ${task.content}${pBadge}`);\n}\n\nreturn Object.values(groups).map(g => {\n  const lines = g.tasks.map((t, idx) => `${idx + 1}. ${t}`).join(\"\\n\");\n  return {\n    json: {\n      userId: g.userId,\n      chatId: g.chatId,\n      taskIds: g.taskIds,\n      text: `📋 <b>TODAY'S TASKS</b>\\n\\n${lines}`\n    }\n  };\n});"
      }
    },
    {
      "id": "send_tasks_notification",
      "name": "Send Tasks Notification",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram account"
        }
      }
    },
    {
      "id": "mark_tasks_notified",
      "name": "Mark Tasks Notified",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE personal_daily_tasks SET notified_at = now(), updated_at = now() WHERE user_id = $1 AND task_date = now()::date AND status = 'PENDING' AND notified_at IS NULL",
        "options": {
          "queryReplacement": "={{ [ $json.userId ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      }
    }
  ],
  "connections": {
    "Morning Schedule Trigger": {
      "main": [
        [
          {
