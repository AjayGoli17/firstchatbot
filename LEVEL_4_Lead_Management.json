        1120,
        -200
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const j = $json;\nconst trig = $('Execute Workflow Trigger').first().json;\nconst val = j.deal_value ? `\\u20b9${Number(j.deal_value).toLocaleString('en-IN')}` : 'not set';\nreturn [{ json: { chatId: trig.chatId,\n  text: `\\u2705 Lead added: <b>${j.business_name}</b>\\nService: ${j.service || '\\u2014'}\\nValue: ${val}\\nStatus: ${j.status}` } }];"
      }
    },
    {
