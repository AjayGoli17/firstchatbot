    {
      "id": "format_list",
      "name": "Format List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        -80
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst trig = $('Execute Workflow Trigger').first().json;\nif (!items.length || !items[0].json.business_name) {\n  return [{ json: { chatId: trig.chatId, text: 'No active leads yet.' } }];\n}\nconst lines = items.map(i => {\n  const d = i.json;\n  const val = d.deal_value ? `\\u20b9${Number(d.deal_value).toLocaleString('en-IN')}` : '\\u2014';\n  return `\\u2022 ${d.business_name} \u2014 ${d.status} \u2014 ${val}`;\n});\nreturn [{ json: { chatId: trig.chatId, text: `\\ud83d\\udccb <b>Active Leads</b>\\n${lines.join('\\n')}` } }];"
      }
    },
