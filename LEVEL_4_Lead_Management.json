      "parameters": {
        "language": "javaScript",
        "jsCode": "const j = $json;\nconst trig = $('Execute Workflow Trigger').first().json;\nconst oldVal = Number(j.deal_value) || 0;\nconst newVal = Number(trig.parameters.deal_value) || 0;\nconst pctChange = oldVal === 0 ? 100 : Math.abs((newVal - oldVal) / oldVal) * 100;\nconst needsApproval = pctChange > 30;\nreturn [{ json: { leadId: j.id, businessName: j.business_name, oldValue: oldVal, newValue: newVal,\n  updatedAt: j.updated_at, chatId: trig.chatId, needsApproval } }];"
