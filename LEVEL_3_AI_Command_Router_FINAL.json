    {
      "parameters": {
        "jsCode": "const systemPrompt = `You are an intent-classification engine for a freelancer's personal operations assistant.\nYou ONLY interpret intent. You NEVER perform calculations, NEVER invent data, and NEVER modify anything.\n\nReturn ONLY a single JSON object, no prose, no markdown fences, matching exactly:\n{\"command\":\"<ONE_OF_ALLOWED_COMMANDS>\",\"confidence\":<0..1 number>,\"parameters\":{...}}\n\nAllowed commands:\nADD_LEAD, LIST_LEADS, GET_LEAD, UPDATE_LEAD, CHANGE_STATUS, UPDATE_DEAL_VALUE,\nRECORD_INTERACTION, ADD_NOTE, GET_LEAD_HISTORY,\nCREATE_FOLLOW_UP, COMPLETE_FOLLOW_UP,\nDAILY_PRIORITY, PIPELINE_ANALYTICS, REVENUE_ANALYTICS, LEAD_ANALYTICS,\nUNKNOWN\n\nParameter fields you may extract (omit any you cannot find in the message, never invent values):\nbusiness_name, contact_name, email, phone, service, status, deal_value, currency,\nnotes, interaction_type, content, follow_up_date, interval_days, report_type.\n\nRules:\n- If the message is ambiguous or missing information required to act, still return your best-guess command but set confidence below 0.6 and omit the missing fields.\n- Never fabricate a business_name, date, or amount that was not stated by the user.\n- If you cannot classify at all, return command \"UNKNOWN\".\n- Output raw JSON only.`;\n\nconst userText = $json.text;\n\nreturn [{\n  json: {\n    chatId: $json.chatId,\n    userId: $json.userId,\n    requestBody: {\n      temperature: 0,\n      systemPrompt,\n      userText\n    }\n  }\n}];"
      },
      "id": "9e312170-4344-4c62-9031-8994a1cc8d98",
      "name": "Build Gemini Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -208,
        384
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ systemInstruction: { parts: [ { text: $json.requestBody.systemPrompt } ] }, contents: [ { role: \"user\", parts: [ { text: $json.requestBody.userText } ] } ], generationConfig: { temperature: $json.requestBody.temperature, responseMimeType: \"application/json\" } }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "fccdfd54-7429-4a03-9985-8009cd1715d8",
      "name": "Gemini Command Router",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        384
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const REQUIRED = {\n  ADD_LEAD: ['business_name'],\n  LIST_LEADS: [],\n  GET_LEAD: ['business_name'],\n  UPDATE_LEAD: ['business_name'],\n  CHANGE_STATUS: ['business_name', 'status'],\n  UPDATE_DEAL_VALUE: ['business_name', 'deal_value'],\n  RECORD_INTERACTION: ['business_name'],\n  ADD_NOTE: ['business_name', 'notes'],\n  GET_LEAD_HISTORY: ['business_name'],\n  CREATE_FOLLOW_UP: ['business_name'],\n  COMPLETE_FOLLOW_UP: ['business_name'],\n  DAILY_PRIORITY: [],\n  PIPELINE_ANALYTICS: [],\n  REVENUE_ANALYTICS: [],\n  LEAD_ANALYTICS: [],\n  UNKNOWN: []\n};\n\nconst ALLOWED_STATUS = ['NEW','CONTACTED','REPLIED','QUALIFIED','PROPOSAL_SENT','NEGOTIATION','WON','LOST'];\n\n// Maps common phrasing Gemini might return to the exact enum value the DB expects.\nconst STATUS_ALIASES = {\n  'PROPOSAL': 'PROPOSAL_SENT',\n  'PROPOSAL SENT': 'PROPOSAL_SENT',\n  'SENT PROPOSAL': 'PROPOSAL_SENT',\n  'SEND PROPOSAL': 'PROPOSAL_SENT',\n  'CONTACT': 'CONTACTED',\n  'REPLY': 'REPLIED',\n  'REPLIED TO': 'REPLIED',\n  'QUALIFY': 'QUALIFIED',\n  'NEGOTIATE': 'NEGOTIATION',\n  'NEGOTIATING': 'NEGOTIATION',\n  'WIN': 'WON',\n  'CLOSED WON': 'WON',\n  'LOSE': 'LOST',\n  'CLOSED LOST': 'LOST',\n  'NEW LEAD': 'NEW'\n};\n\nconst chatId = $('Build Gemini Request').first().json.chatId;\nconst userId = $('Build Gemini Request').first().json.userId;\n\nlet parsed = null;\ntry {\n  const raw = $input.first().json;\n  const candidate = raw.candidates && raw.candidates[0];\n  if (raw.error || !candidate || !candidate.content || !candidate.content.parts) throw new Error('gemini_error');\n  let text = candidate.content.parts.map(p => p.text || '').join('');\n  text = text.trim().replace(/^```json/i, '').replace(/^```/, '').replace(/```$/, '').trim();\n  parsed = JSON.parse(text);\n} catch (e) {\n  return [{ json: { chatId, userId, command: 'UNKNOWN', confidence: 0, parameters: {}, missing: [], systemError: true } }];\n}\n\nlet command = typeof parsed.command === 'string' ? parsed.command.toUpperCase().trim() : 'UNKNOWN';\nif (!(command in REQUIRED)) command = 'UNKNOWN';\n\nlet confidence = typeof parsed.confidence === 'number' ? parsed.confidence : 0;\nlet parameters = (parsed.parameters && typeof parsed.parameters === 'object') ? parsed.parameters : {};\n\nif (parameters.status) {\n  let s = String(parameters.status).toUpperCase().trim();\n  if (STATUS_ALIASES[s]) s = STATUS_ALIASES[s];\n  parameters.status = s;\n  if (!ALLOWED_STATUS.includes(parameters.status)) {\n    parameters._invalidStatus = parameters.status;\n    delete parameters.status;\n  }\n}\n\nif (parameters.deal_value !== undefined) {\n  const v = Number(String(parameters.deal_value).toString().replace(/[^0-9.\\-]/g, ''));\n  parameters.deal_value = isNaN(v) ? undefined : v;\n}\n\nconst missing = (REQUIRED[command] || []).filter(f => parameters[f] === undefined || parameters[f] === null || parameters[f] === '');\n\nreturn [{\n  json: { chatId, userId, command, confidence, parameters, missing, systemError: false }\n}];\n"
      },
