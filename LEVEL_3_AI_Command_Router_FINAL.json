   "id": "112a3b92-d25e-435d-b221-e53586e50fd2",
   "name": "Needs Clarification",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    448,
    384
   ]
  },
  {
   "parameters": {
    "jsCode": "const j = $('Should Save Pending').first().json;\nconst FIELD_QUESTIONS = {\n  business_name: \"What's the business name?\",\n  service: 'What service is this lead interested in?',\n  deal_value: \"What's the expected deal value? (e.g. \\u20b930,000)\",\n  status: 'What status should I set it to? (e.g. Contacted, Proposal Sent, Won, Lost)',\n  notes: 'What note would you like to add?',\n  content: 'What note would you like to save?',\n  follow_up_date: 'When should I remind you? (e.g. tomorrow 10am)',\n  reminder_text: 'What should I remind you about?',\n  task_name: 'What task would you like to add?',\n  tasks: 'What tasks would you like to add?',\n  note_id: 'Which note ID?',\n  reminder_id: 'Which reminder ID?',\n  task_id: 'Which task ID?'\n};\nlet text;\nif (j.systemError) {\n  text = \"\\u26a0\\ufe0f I couldn't reach the AI service. Please try again in a moment.\";\n} else if (j.command === 'AMBIGUOUS_DELETE') {\n  const bName = (j.parameters && j.parameters.business_name) ? j.parameters.business_name : 'this';\n  text = `\\u26a0\\ufe0f Do you want to delete the lead \"${bName}\", its follow-up, or both?\\n\\n\\u2022 \"delete lead ${bName}\"\\n\\u2022 \"delete followup for ${bName}\"`;\n} else if (j.command === 'UNKNOWN') {\n  text = \"\\ud83e\\udd14 I didn't understand that. Try something like:\\n\\u2022 \\\"Add ABC School as a \\u20b925,000 website lead\\\"\\n\\u2022 \\\"Show my active leads\\\"\\n\\u2022 \\\"Move ABC School to proposal\\\"\\n\\u2022 \\\"Note down this:\\\"\\n\\u2022 \\\"Remind me on Monday to follow up\\\"\\n\\u2022 \\\"Tasks for today:\\\"\";\n} else if (j.missing && j.missing.length) {\n  const field = j.missing[0];\n  text = FIELD_QUESTIONS[field] || `I still need: ${field}. Could you send that?`;\n} else {\n  text = \"\\u26a0\\ufe0f I'm not confident I understood that correctly. Could you rephrase?\";\n}\nreturn [{ json: { chatId: j.chatId, text } }];"
   },
