    {
      "parameters": {
        "jsCode": "const j = $json;\nlet text;\nif (j.systemError) {\n  text = \"\\u26a0\\ufe0f I couldn't reach the AI service. Please try again in a moment.\";\n} else if (j.command === 'UNKNOWN') {\n  text = \"\\ud83e\\udd14 I didn't understand that. Try something like:\\n\\u2022 \\\"Add ABC School as a \\u20b925,000 website lead\\\"\\n\\u2022 \\\"Show my active leads\\\"\\n\\u2022 \\\"Move ABC School to proposal\\\"\";\n} else if (j.missing && j.missing.length) {\n  text = `I can do that, but I still need: ${j.missing.join(', ')}. Could you send that?`;\n} else {\n  text = \"\\u26a0\\ufe0f I'm not confident I understood that correctly. Could you rephrase?\";\n}\nreturn [{ json: { chatId: j.chatId, text } }];"
      },
