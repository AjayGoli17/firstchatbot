    "jsCode": "const STATUS_ALIASES = {\n  'PROPOSAL': 'PROPOSAL_SENT', 'PROPOSAL SENT': 'PROPOSAL_SENT', 'SENT PROPOSAL': 'PROPOSAL_SENT',\n  'SEND PROPOSAL': 'PROPOSAL_SENT', 'CONTACT': 'CONTACTED', 'REPLY': 'REPLIED', 'REPLIED TO': 'REPLIED',\n  'QUALIFY': 'QUALIFIED', 'NEGOTIATE': 'NEGOTIATION', 'NEGOTIATING': 'NEGOTIATION', 'WIN': 'WON',\n  'CLOSED WON': 'WON', 'LOSE': 'LOST', 'CLOSED LOST': 'LOST', 'NEW LEAD': 'NEW'\n};\nconst ALLOWED_STATUS = ['NEW','CONTACTED','REPLIED','QUALIFIED','PROPOSAL_SENT','NEGOTIATION','WON','LOST'];\nconst REQUIRED = {\n  ADD_LEAD: ['business_name'], LIST_LEADS: [], GET_LEAD: ['business_name'], UPDATE_LEAD: ['business_name'],\n  CHANGE_STATUS: ['business_name', 'status'], UPDATE_DEAL_VALUE: ['business_name', 'deal_value'],\n  DELETE_LEAD: ['business_name'], DELETE_ALL_LEADS: [], DELETE_EVERYTHING: [],\n  RECORD_INTERACTION: ['business_name'], ADD_NOTE: ['business_name', 'notes'], GET_LEAD_HISTORY: ['business_name'],\n  DELETE_ALL_INTERACTIONS: [],\n  CREATE_FOLLOW_UP: ['business_name'], COMPLETE_FOLLOW_UP: ['business_name'],\n  UPDATE_FOLLOW_UP: ['business_name'], CANCEL_FOLLOW_UP: ['business_name'], DELETE_FOLLOW_UP: ['business_name'], LIST_FOLLOW_UPS: [], DELETE_ALL_FOLLOWUPS: [],\n  AMBIGUOUS_DELETE: ['business_name'],\n  DAILY_PRIORITY: [], PIPELINE_ANALYTICS: [], REVENUE_ANALYTICS: [], LEAD_ANALYTICS: [],\n  ADD_STANDALONE_NOTE: ['content'], LIST_STANDALONE_NOTES: [], DELETE_STANDALONE_NOTE: ['note_id'], DELETE_ALL_STANDALONE_NOTES: [],\n  CREATE_REMINDER: ['reminder_text', 'follow_up_date'], LIST_REMINDERS: [], DELETE_REMINDER: ['reminder_id'], DELETE_ALL_REMINDERS: [],\n  CREATE_DAILY_TASKS: ['tasks'], LIST_TASKS: [], ADD_TASK: ['task_name'], UPDATE_TASK: ['task_id'], COMPLETE_TASK: ['task_id'], DELETE_TASK: ['task_id'], DELETE_ALL_TASKS: [],\n  UNKNOWN: []\n};\n\nconst trig = $('Restore Context').first().json;\nconst pending = $json;\nlet parameters = typeof pending.parameters === 'string' ? JSON.parse(pending.parameters || '{}') : (pending.parameters || {});\nconst missingList = typeof pending.missing === 'string' ? JSON.parse(pending.missing || '[]') : (pending.missing || []);\nconst field = missingList[0];\nlet value = (trig.text || '').trim();\n\nif (field === 'deal_value') {\n  const v = Number(value.replace(/[^0-9.\\-]/g, ''));\n  if (!isNaN(v)) parameters.deal_value = v;\n} else if (field === 'status') {\n  let s = value.toUpperCase().trim();\n  if (STATUS_ALIASES[s]) s = STATUS_ALIASES[s];\n  if (ALLOWED_STATUS.includes(s)) parameters.status = s;\n} else if (field === 'tasks' && typeof value === 'string') {\n  parameters.tasks = value.split('\\n').map(t => t.trim().replace(/^[-*•0-9.)\\s]+/, '')).filter(Boolean);\n} else if (field) {\n  parameters[field] = value;\n}\n\nconst missing = (REQUIRED[pending.command] || []).filter(f => {\n  const val = parameters[f];\n  if (val === undefined || val === null || val === '') return true;\n  if (Array.isArray(val) && val.length === 0) return true;\n  return false;\n});\n\nreturn [{ json: { chatId: trig.chatId, userId: trig.userId, command: pending.command, confidence: 1, parameters, missing, systemError: false } }];"
