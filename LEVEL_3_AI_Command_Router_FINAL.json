  {
   "parameters": {
    "jsCode": "const item = $input.first().json;\nconst cb = item.callback_query;\nconst msg = item.message;\n\nif (cb) {\n  return [{\n    json: {\n      isCallback: true,\n      chatId: cb.message.chat.id,\n      userId: cb.from.id,\n      messageId: cb.message.message_id,\n      callbackQueryId: cb.id,\n      callbackData: cb.data || '',\n      text: '',\n      updateId: item.update_id != null ? item.update_id : null\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    isCallback: false,\n    chatId: msg ? msg.chat.id : null,\n    userId: msg ? msg.from.id : null,\n    messageId: msg ? msg.message_id : null,\n    callbackQueryId: null,\n    callbackData: '',\n    text: msg ? (msg.text || '') : '',\n    updateId: item.update_id != null ? item.update_id : null\n  }\n}];"
   },
