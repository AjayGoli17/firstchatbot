   "name": "Format Follow-up List",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    560,
    -60
   ],
   "parameters": {
    "language": "javaScript",
    "jsCode": "const trig = $('Execute Workflow Trigger').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.id);\nif (!rows.length) {\n  return [{ json: { chatId: trig.chatId, text: 'No pending follow-ups right now.' } }];\n}\nconst lines = rows.map(r => `\\u2022 <b>${r.business_name}</b> \\u2014 ${new Date(r.due_at).toDateString()}`);\nreturn [{ json: { chatId: trig.chatId, text: `\\ud83d\\udd14 <b>Follow-ups</b>\\n\\n${lines.join('\\n')}` } }];"
   }
