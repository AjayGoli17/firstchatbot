  {
   "id": "list_query",
   "name": "Query Follow-ups",
   "type": "n8n-nodes-base.postgres",
   "typeVersion": 2.5,
   "position": [
    340,
    -60
   ],
   "parameters": {
    "operation": "executeQuery",
    "query": "SELECT f.id, f.due_at, f.status, l.business_name AS business_name FROM follow_ups f JOIN leads l ON l.id = f.lead_id WHERE f.status = 'PENDING' AND ( $1 = 'OVERDUE' AND f.due_at < now()       OR $1 = 'TODAY' AND f.due_at::date = now()::date       OR $1 NOT IN ('OVERDUE','TODAY') ) ORDER BY f.due_at ASC LIMIT 20",
    "options": {
     "queryReplacement": "={{ [ ($json.parameters && $json.parameters.filter) ? String($json.parameters.filter).toUpperCase() : 'ALL' ] }}"
    }
   },
   "credentials": {
    "postgres": {
     "id": "REPLACE_ME",
     "name": "Postgres account"
    }
   },
   "alwaysOutputData": true
  },
  {
   "id": "format_list",
   "name": "Format Follow-up List",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    560,
    -60
   ],
   "parameters": {
    "language": "javaScript",
    "jsCode": "const trig = $('Execute Workflow Trigger').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.id);\nif (!rows.length) {\n  return [{ json: { chatId: trig.chatId, text: 'No pending follow-ups right now.' } }];\n}\nconst lines = rows.map(r => `\\u2022 <b>${r.business_name}</b> \\u2014 ${new Date(r.due_at).toDateString()}`);\nreturn [{ json: { chatId: trig.chatId, text: `\\ud83d\\udd14 <b>Follow-ups</b>\\n\\n${lines.join('\\n')}` } }];"
   }
  },
