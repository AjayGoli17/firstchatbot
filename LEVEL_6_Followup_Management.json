    "jsCode": "const trig = $('Execute Workflow Trigger').first().json;\nconst lead = $('Find Lead By Name').first().json;\nconst pending = $('Find Pending Followup (Update)').first().json;\nconst p = trig.parameters || {};\nlet dueAt;\nif (p.follow_up_date) {\n  const d = new Date(p.follow_up_date);\n  dueAt = isNaN(d.getTime()) ? null : d.toISOString();\n}\nif (!dueAt) {\n  const days = Number(p.interval_days) > 0 ? Number(p.interval_days) : 3;\n  dueAt = new Date(Date.now() + days * 24 * 60 * 60 * 1000).toISOString();\n}\nreturn [{ json: { followupId: pending.id, calendarEventId: pending.calendar_event_id || '', leadId: lead.id, businessName: lead.business_name, dueAt, chatId: trig.chatId } }];"
