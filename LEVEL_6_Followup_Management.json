      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const lead = $('Find Lead By Name').first().json;\nconst trig = $('Execute Workflow Trigger').first().json;\nreturn [{ json: { chatId: trig.chatId, text: `${lead.business_name} has no pending follow-up.` } }];"
      }
    }
