  {
   "id": "compute_due",
   "name": "Compute Due Date",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    900,
    -40
   ],
   "parameters": {
    "language": "javaScript",
    "jsCode": "function parseNaturalDateTime(str, now = new Date()) {\n  if (!str || typeof str !== 'string') return null;\n  const s = str.trim().toLowerCase();\n  if (/^\\d{4}-\\d{2}-\\d{2}(T|\\s)\\d{2}:\\d{2}/.test(str)) {\n    const d = new Date(str);\n    if (!isNaN(d.getTime())) return d.toISOString();\n  }\n  const kolkataNowStr = new Intl.DateTimeFormat('en-US', {\n    timeZone: 'Asia/Kolkata', year: 'numeric', month: 'numeric', day: 'numeric',\n    hour: 'numeric', minute: 'numeric', second: 'numeric', hour12: false\n  }).format(now);\n  const [datePart] = kolkataNowStr.split(', ');\n  const [mStr, dStr, yStr] = datePart.split('/');\n  let targetYear = parseInt(yStr, 10);\n  let targetMonth = parseInt(mStr, 10) - 1;\n  let targetDay = parseInt(dStr, 10);\n  let targetHour = 10;\n  let targetMinute = 0;\n\n  const timeMatch = s.match(/(?:at\\s+)?(\\d{1,2})(?::(\\d{2}))?\\s*(am|pm)?/i);\n  if (timeMatch && (timeMatch[3] || s.includes('at ') || timeMatch[2])) {\n    let h = parseInt(timeMatch[1], 10);\n    const min = timeMatch[2] ? parseInt(timeMatch[2], 10) : 0;\n    const meridiem = timeMatch[3] ? timeMatch[3].toLowerCase() : null;\n    if (meridiem === 'pm' && h < 12) h += 12;\n    if (meridiem === 'am' && h === 12) h = 0;\n    if (h >= 0 && h <= 23 && min >= 0 && min <= 59) {\n      targetHour = h;\n      targetMinute = min;\n    }\n  }\n\n  const inHoursMatch = s.match(/in\\s+(\\d+)\\s+hour/);\n  const inMinsMatch = s.match(/in\\s+(\\d+)\\s+min/);\n  const inDaysMatch = s.match(/in\\s+(\\d+)\\s+day/);\n  if (inHoursMatch) return new Date(now.getTime() + parseInt(inHoursMatch[1], 10) * 3600000).toISOString();\n  if (inMinsMatch) return new Date(now.getTime() + parseInt(inMinsMatch[1], 10) * 60000).toISOString();\n  if (inDaysMatch) {\n    targetDay += parseInt(inDaysMatch[1], 10);\n  } else if (s.includes('tomorrow')) {\n    targetDay += 1;\n  } else if (s.includes('today')) {\n  } else {\n    const weekdays = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];\n    const weekdayIdx = weekdays.findIndex(w => s.includes(w));\n    if (weekdayIdx !== -1) {\n      const curDay = new Date(Date.UTC(targetYear, targetMonth, targetDay)).getUTCDay();\n      let diff = weekdayIdx - curDay;\n      if (diff <= 0 || s.includes('next')) diff += 7;\n      targetDay += diff;\n    } else {\n      const months = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];\n      let foundMonth = -1;\n      for (let i = 0; i < 12; i++) {\n        if (s.includes(months[i])) { foundMonth = i; break; } \n      }\n      if (foundMonth !== -1) {\n        targetMonth = foundMonth;\n        const dayMatch = s.match(/(\\d{1,2})(?:st|nd|rd|th)?/);\n        if (dayMatch) targetDay = parseInt(dayMatch[1], 10);\n        const yearMatch = s.match(/\\b(20\\d{2})\\b/);\n        if (yearMatch) targetYear = parseInt(yearMatch[1], 10);\n      } else {\n        const parsed = new Date(str);\n        if (!isNaN(parsed.getTime())) return parsed.toISOString();\n        return null;\n      }\n    }\n  }\n  const utcMillis = Date.UTC(targetYear, targetMonth, targetDay, targetHour, targetMinute, 0) - (5.5 * 3600000);\n  return new Date(utcMillis).toISOString();\n}\n\nconst trig = $('Execute Workflow Trigger').first().json;\nconst p = trig.parameters || {};\nlet dueAt = null;\nif (p.follow_up_date) {\n  dueAt = parseNaturalDateTime(p.follow_up_date) || (isNaN(new Date(p.follow_up_date).getTime()) ? null : new Date(p.follow_up_date).toISOString());\n}\nif (!dueAt) {\n  const days = Number(p.interval_days) > 0 ? Number(p.interval_days) : 3;\n  dueAt = new Date(Date.now() + days * 24 * 60 * 60 * 1000).toISOString();\n}\nreturn [{ json: { leadId: $json.id, businessName: $json.business_name, dueAt, chatId: trig.chatId } }];"
   }
  },
