    {
      "parameters": {
        "jsCode": "const leadRecords = $input.all();\nconst trig = $('Execute Workflow Trigger').first().json;\nif (!leadRecords.length || !leadRecords[0].json.business_name) {\n  return [{ json: { chatId: trig.chatId, text: 'No active leads yet.' } }];\n}\nconst lines = leadRecords.map(i => {\n  const d = i.json;\n  const sym = (d.currency === 'USD' ? '$' : (d.currency === 'EUR' ? '€' : (d.currency === 'GBP' ? '£' : (d.currency && d.currency !== 'INR' ? (d.currency + ' ') : '₹'))));\n  const val = d.deal_value ? `${sym}${Number(d.deal_value).toLocaleString('en-IN')}` : '—';\n  return `• ${d.business_name} — ${d.status} — ${val}`;\n});\nreturn [{ json: { chatId: trig.chatId, text: `📋 <b>Active Leads</b>\\n${lines.join('\\n')}` } }];"
      },
