      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT business_name, status, deal_value, currency, next_follow_up_at FROM leads WHERE status NOT IN ('WON','LOST') ORDER BY updated_at DESC LIMIT 25",
        "options": {}
      },
      "id": "f3697ea3-9f62-42d3-ac58-cd5fef2c0ac8",
