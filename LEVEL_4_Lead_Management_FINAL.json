      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO leads (business_name, contact_name, email, phone, service, status, deal_value, currency) VALUES ($1,$2,$3,$4,$5,'NEW',$6,$7) RETURNING *",
        "options": {
          "queryReplacement": "={{ [$('Execute Workflow Trigger').first().json.parameters.business_name, $('Execute Workflow Trigger').first().json.parameters.contact_name || null, $('Execute Workflow Trigger').first().json.parameters.email || null, $('Execute Workflow Trigger').first().json.parameters.phone || null, $('Execute Workflow Trigger').first().json.parameters.service || null, $('Execute Workflow Trigger').first().json.parameters.deal_value || 0, $('Execute Workflow Trigger').first().json.parameters.currency || 'INR'] }}"
        }
      },
      "id": "c30686a2-9d09-4c3c-ac0d-121228d69563",
      "name": "Insert Lead",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        0,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $json;\nconst trig = $('Execute Workflow Trigger').first().json;\nconst sym = (j.currency === 'USD' ? '$' : (j.currency === 'EUR' ? '€' : (j.currency === 'GBP' ? '£' : (j.currency && j.currency !== 'INR' ? (j.currency + ' ') : '\\u20b9'))));\nconst val = j.deal_value ? `${sym}${Number(j.deal_value).toLocaleString('en-IN')}` : 'not set';\nreturn [{ json: { chatId: trig.chatId,\n  text: `\\u2705 Lead added: <b>${j.business_name}</b>\\nService: ${j.service || '\\u2014'}\\nValue: ${val}\\nStatus: ${j.status}` } }];"
      },
      "id": "13962678-6d65-4a55-b8d0-3048849e3151",
      "name": "Build Add Confirmation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
