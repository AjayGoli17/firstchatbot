        "jsCode": "const j = $json;\nconst trig = $('Execute Workflow Trigger').first().json;\nconst sym = (j.currency === 'USD' ? '$' : (j.currency === 'EUR' ? '€' : (j.currency === 'GBP' ? '£' : (j.currency && j.currency !== 'INR' ? (j.currency + ' ') : '\\u20b9'))));\nconst val = j.deal_value ? `${sym}${Number(j.deal_value).toLocaleString('en-IN')}` : '\\u2014';\nconst lastContact = j.last_contact_at ? new Date(j.last_contact_at).toDateString() : 'never';\nconst nextFollow = j.next_follow_up_at ? new Date(j.next_follow_up_at).toDateString() : 'none scheduled';\nreturn [{ json: { chatId: trig.chatId,\n  text: `\\ud83d\\udcc7 <b>${j.business_name}</b>\\nContact: ${j.contact_name || '\\u2014'}\\nEmail: ${j.email || '\\u2014'}\\nPhone: ${j.phone || '\\u2014'}\\nService: ${j.service || '\\u2014'}\\nStatus: ${j.status}\\nValue: ${val}\\nLast contact: ${lastContact}\\nNext follow-up: ${nextFollow}\\nNotes: ${j.notes || '\\u2014'}` } }];"
