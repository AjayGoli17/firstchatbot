      ],
      "parameters": {
        "resource": "callback",
        "operation": "answerQuery",
        "queryId": "={{$json.callbackQueryId}}",
        "text": "="
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram account"
        }
      }
    },
    {
