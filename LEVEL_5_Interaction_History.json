    {
      "id": "find_lead5",
      "name": "Find Lead By Name",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, business_name, status FROM leads WHERE LOWER(business_name) = LOWER($1) LIMIT 1",
        "options": {
          "queryReplacement": "={{ [$json.parameters.business_name] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "if_lead5",
      "name": "Lead Found",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{$json.id}}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "not_found5",
      "name": "Lead Not Found",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        320
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const trig = $('Execute Workflow Trigger').first().json;\nreturn [{ json: { chatId: trig.chatId, text: `\\u26a0\\ufe0f I couldn't find a lead called \"${trig.parameters.business_name}\".` } }];"
      }
    },
    {
      "id": "route5",
      "name": "Route Interaction Command",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        660,
        140
      ],
      "parameters": {
        "mode": "expression",
        "output": "={{ ['RECORD_INTERACTION','ADD_NOTE','GET_LEAD_HISTORY'].indexOf($('Execute Workflow Trigger').first().json.command) }}",
        "options": {}
      }
    },
    {
      "id": "insert_interaction",
      "name": "Insert Interaction",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        900,
        -80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO interactions (lead_id, interaction_type, content, interaction_date) VALUES ($1,$2,$3, now()) RETURNING *",
        "options": {
          "queryReplacement": "={{ [$json.id, ($('Execute Workflow Trigger').first().json.parameters.interaction_type || 'CONTACT').toUpperCase(), $('Execute Workflow Trigger').first().json.parameters.content || $('Execute Workflow Trigger').first().json.text || null] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "update_last_contact",
      "name": "Update Last Contact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1120,
        -80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE leads SET last_contact_at = now() WHERE id = $1",
        "options": {
          "queryReplacement": "={{ [$('Find Lead By Name').first().json.id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "upsert_followup",
      "name": "Create Pending Followup If Absent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1340,
        -80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO follow_ups (lead_id, due_at, attempt_number, status) VALUES ($1, now() + interval '3 days', 1, 'PENDING') ON CONFLICT (lead_id) WHERE status = 'PENDING' DO NOTHING RETURNING *",
        "options": {
          "queryReplacement": "={{ [$('Find Lead By Name').first().json.id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "update_next_followup",
      "name": "Sync Next Follow Up On Lead",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1560,
        -80
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE leads SET next_follow_up_at = (SELECT due_at FROM follow_ups WHERE lead_id = $1 AND status = 'PENDING' ORDER BY due_at LIMIT 1) WHERE id = $1",
        "options": {
          "queryReplacement": "={{ [$('Find Lead By Name').first().json.id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "interaction_confirm",
      "name": "Build Interaction Confirmation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        -80
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const lead = $('Find Lead By Name').first().json;\nconst trig = $('Execute Workflow Trigger').first().json;\nreturn [{ json: { chatId: trig.chatId, text: `\\u2705 Logged interaction with <b>${lead.business_name}</b>. Next follow-up scheduled.` } }];"
      }
    },
    {
      "id": "insert_note",
      "name": "Insert Note",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        900,
        140
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO interactions (lead_id, interaction_type, content, interaction_date) VALUES ($1,'NOTE',$2, now()) RETURNING *",
        "options": {
          "queryReplacement": "={{ [$json.id, $('Execute Workflow Trigger').first().json.parameters.notes || $('Execute Workflow Trigger').first().json.parameters.content] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "note_confirm",
      "name": "Build Note Confirmation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        140
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const lead = $('Find Lead By Name').first().json;\nconst trig = $('Execute Workflow Trigger').first().json;\nreturn [{ json: { chatId: trig.chatId, text: `\\ud83d\\udcdd Note added to <b>${lead.business_name}</b>.` } }];"
      }
    },
    {
      "id": "select_history",
      "name": "Select History",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        900,
        320
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT interaction_type, content, interaction_date FROM interactions WHERE lead_id = $1 ORDER BY interaction_date DESC LIMIT 15",
        "options": {
          "queryReplacement": "={{ [$json.id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "format_history",
      "name": "Format History",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        320
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst lead = $('Find Lead By Name').first().json;\nconst trig = $('Execute Workflow Trigger').first().json;\nif (!items.length || !items[0].json.interaction_type) {\n  return [{ json: { chatId: trig.chatId, text: `No history yet for <b>${lead.business_name}</b>.` } }];\n}\nconst lines = items.map(i => {\n  const d = i.json;\n  const date = new Date(d.interaction_date).toDateString();\n  return `\\u2022 [${date}] ${d.interaction_type}${d.content ? ': ' + d.content : ''}`;\n});\nreturn [{ json: { chatId: trig.chatId, text: `\\ud83d\\udcd6 <b>History \u2014 ${lead.business_name}</b>\\n${lines.join('\\n')}` } }];"
      }
    }
