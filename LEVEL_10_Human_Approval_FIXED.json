{
  "name": "LEVEL_10_Human_Approval",
  "nodes": [
    {
      "id": "trigger10",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        150
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "route_mode",
      "name": "Route Mode",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        220,
        150
      ],
      "parameters": {
        "mode": "expression",
        "output": "={{ $json.mode === 'REQUEST' ? 0 : 1 }}",
        "options": {}
      }
    },
    {
      "id": "build_request",
      "name": "Build Approval Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        60
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const j = $json;\n// ISO timestamps contain colons, which collide with our ':' delimited callback_data.\n// Strip them out here; parsed back on the callback side by re-inserting them positionally.\nconst version = j.recordVersion ? new Date(j.recordVersion).toISOString().replace(/[:]/g, '') : '';\nconst base = `appr:${j.leadId}:${j.field}:${j.newValue}:${version}`;\nconst label = j.field === 'status' ? `${j.oldValue} \\u2192 ${j.newValue}` : `\\u20b9${Number(j.oldValue).toLocaleString('en-IN')} \\u2192 \\u20b9${Number(j.newValue).toLocaleString('en-IN')}`;\nreturn [{ json: {\n  chatId: j.chatId,\n  businessName: j.businessName,\n  fieldLabel: j.field === 'status' ? 'Status change' : 'Deal value change',\n  changeLabel: label,\n  callbackApprove: `${base}:A`,\n  callbackReject: `${base}:R`\n} }];"
      }
    },
    {
      "id": "send_approval",
      "name": "Send Approval Request",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        680,
        60
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{$json.chatId}}",
        "text": "=Confirm this change?\n\n<b>{{$json.businessName}}</b>\n{{$json.fieldLabel}}: {{$json.changeLabel}}",
        "additionalFields": {
          "parse_mode": "HTML"
        },
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "\u2705 Approve",
                    "additionalFields": {
                      "callback_data": "={{$json.callbackApprove}}"
                    }
                  },
                  {
                    "text": "\u274c Reject",
                    "additionalFields": {
                      "callback_data": "={{$json.callbackReject}}"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram account"
        }
      }
    },
    {
      "id": "request_ack",
      "name": "Suppress Duplicate Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        60
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "return [{ json: { chatId: $('Build Approval Request').first().json.chatId, text: '' } }];"
      }
    },
    {
      "id": "parse_appr",
      "name": "Parse Approval Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        240
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const j = $json;\nconst parts = (j.callbackData || '').split(':'); // appr:<leadId>:<field>:<newValue>:<isoVersionNoColons>:<A|R>\n// Re-insert the colons that were stripped out before the timestamp went into callback_data,\n// so this is a valid ISO timestamp again for comparisons and the SQL parameter.\nconst version = (parts[4] || '').replace(/T(\\d{2})(\\d{2})(\\d{2})/, 'T$1:$2:$3');\nreturn [{ json: {\n  leadId: Number(parts[1]), field: parts[2], newValue: parts[3], version, decision: parts[5],\n  chatId: j.chatId, callbackQueryId: j.callbackQueryId, messageId: j.messageId\n} }];"
      }
    },
    {
      "id": "reread",
      "name": "Reread Current Record",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        680,
        240
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, business_name, status, deal_value, updated_at FROM leads WHERE id = $1",
        "options": {
          "queryReplacement": "={{ [$json.leadId] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "check_stale",
      "name": "Check Staleness",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        240
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const p = $('Parse Approval Callback').first().json;\nconst cur = $json;\nconst curVersion = cur.updated_at ? new Date(cur.updated_at).toISOString() : '';\nconst stale = curVersion !== p.version;\nreturn [{ json: { ...p, currentBusinessName: cur.business_name, stale } }];"
      }
    },
    {
      "id": "if_stale",
      "name": "Is Stale",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1120,
        240
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{$json.stale}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "stale_msg",
      "name": "Build Stale Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        180
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const j = $json;\nreturn [{ json: { chatId: j.chatId, callbackQueryId: j.callbackQueryId, messageId: j.messageId,\n  text: `\\u26a0\\ufe0f This record changed since the request was made. Please re-run the command to review the current value.` } }];"
      }
    },
    {
      "id": "if_decision_approve",
      "name": "Is Approved",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1340,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{$json.decision}}",
              "rightValue": "A",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "reject_msg",
      "name": "Build Reject Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        360
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const j = $json;\nreturn [{ json: { chatId: j.chatId, callbackQueryId: j.callbackQueryId, messageId: j.messageId,\n  text: `\\u274c Change rejected for <b>${j.currentBusinessName}</b>. No update made.` } }];"
      }
    },
    {
      "id": "apply_change",
      "name": "Apply Approved Change",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1560,
        240
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE leads SET\n  status = CASE WHEN $2 = 'status' THEN $3 ELSE status END,\n  deal_value = CASE WHEN $2 = 'deal_value' THEN $3::numeric ELSE deal_value END,\n  won_at = CASE WHEN $2 = 'status' AND $3 = 'WON' THEN now() ELSE won_at END\nWHERE id = $1\nRETURNING *",
        "options": {
          "queryReplacement": "={{ [$json.leadId, $json.field, $json.newValue] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_ME",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "approve_msg",
      "name": "Build Approve Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        240
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const j = $json;\nconst parsed = $('Check Staleness').first().json;\nif (!j.id) {\n  return [{ json: { chatId: parsed.chatId, callbackQueryId: parsed.callbackQueryId, messageId: parsed.messageId,\n    text: `\\u26a0\\ufe0f Couldn't apply the change \u2014 the record changed. Please retry.` } }];\n}\nreturn [{ json: { chatId: parsed.chatId, callbackQueryId: parsed.callbackQueryId, messageId: parsed.messageId,\n  text: `\\u2705 Approved. <b>${j.business_name}</b> updated.` } }];"
      }
    },
    {
      "id": "merge_appr",
      "name": "Merge Approval Outcome",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        2000,
        260
      ],
      "parameters": {
        "mode": "chooseBranchesMerge",
        "numberInputs": 3
      }
    },
    {
      "id": "answer_appr_cb",
      "name": "Answer Callback Query",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2220,
        260
      ],
      "parameters": {
        "resource": "callback",
        "operation": "answerQuery",
        "queryId": "={{$json.callbackQueryId}}",
        "text": "="
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram account"
        }
      }
    },
    {
      "id": "edit_appr_msg",
      "name": "Edit Approval Message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2440,
        260
      ],
      "parameters": {
        "resource": "message",
        "operation": "editMessageText",
        "chatId": "={{$json.chatId}}",
        "messageId": "={{$json.messageId}}",
        "text": "={{$json.text}}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
